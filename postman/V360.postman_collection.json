{
  "info": {
    "name": "V360 Purchase Order Connector",
    "description": "Fluxo demonstrativo da Parte 1. Execute as importações antes das consultas e conferências.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "validationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/actuator/health"
      }
    },
    {
      "name": "02 - Importações",
      "item": [
        {
          "name": "Importar Alfa",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchase_orders\": [\n    {\n      \"po_number\": \"4500001234\",\n      \"created_at\": \"2026-08-05\",\n      \"status\": \"open\",\n      \"currency\": \"BRL\",\n      \"vendor\": {\"tax_id\": \"23456789000101\", \"name\": \"Metalúrgica São Jorge S.A.\"},\n      \"items\": [\n        {\"line\": 10, \"material\": \"MAT-1001\", \"description\": \"Chapa de aço 2mm\", \"uom\": \"UN\", \"quantity_ordered\": 100, \"quantity_received\": 60, \"unit_price\": 45.90},\n        {\"line\": 20, \"material\": \"MAT-1002\", \"description\": \"Perfil U 3m\", \"uom\": \"UN\", \"quantity_ordered\": 50, \"quantity_received\": 0, \"unit_price\": 128.75}\n      ]\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/imports/alfa"
          }
        },
        {
          "name": "Importar Beta",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {"key": "headersFile", "type": "file", "src": "../samples/beta/cabecalho.csv"},
                {"key": "itemsFile", "type": "file", "src": "../samples/beta/itens.csv"}
              ]
            },
            "url": "{{baseUrl}}/api/v1/imports/beta"
          }
        }
      ]
    },
    {
      "name": "03 - Pedidos",
      "item": [
        {
          "name": "Listar todos",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/purchase-orders"}
        },
        {
          "name": "Filtrar Beta abertos com saldo",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/purchase-orders?source=BETA&status=OPEN&pendingOnly=true"}
        },
        {
          "name": "Detalhar pedido Alfa",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/purchase-orders/ALFA/4500001234"}
        }
      ]
    },
    {
      "name": "04 - Conferências",
      "item": [
        {
          "name": "Nota aprovada",
          "event": [{
            "listen": "test",
            "script": {"exec": ["if (pm.response.code === 200) { pm.collectionVariables.set('validationId', pm.response.json().id); }"]}
          }],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"vendorTaxId\": \"23456789000101\",\n  \"items\": [{\"materialCode\": \"MAT-1001\", \"quantity\": 40, \"totalAmount\": 1836.00}]\n}"},
            "url": "{{baseUrl}}/api/v1/purchase-orders/ALFA/4500001234/invoice-validations"
          }
        },
        {
          "name": "Nota com múltiplas divergências",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"vendorTaxId\": \"11111111000111\",\n  \"items\": [{\"materialCode\": \"MAT-1001\", \"quantity\": 50, \"totalAmount\": 1.00}]\n}"},
            "url": "{{baseUrl}}/api/v1/purchase-orders/ALFA/4500001234/invoice-validations"
          }
        },
        {
          "name": "Consultar última conferência aprovada",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/invoice-validations/{{validationId}}"}
        }
      ]
    },
    {
      "name": "05 - Relatório",
      "item": [
        {
          "name": "Relatório geral",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/reports/invoice-validations"}
        },
        {
          "name": "Relatório Alfa por período",
          "request": {"method": "GET", "url": "{{baseUrl}}/api/v1/reports/invoice-validations?source=ALFA&from=2026-01-01T00:00:00Z&to=2026-12-31T23:59:59Z"}
        }
      ]
    }
  ]
}

